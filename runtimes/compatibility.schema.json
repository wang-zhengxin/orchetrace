{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchetrace.dev/schemas/runtime-compatibility.schema.json",
  "title": "Orchetrace Runtime Compatibility Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtimes"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtime" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "coverage",
        "version_basis",
        "formats",
        "test_scripts",
        "unknown_record_policy",
        "limitations"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "coverage": {
          "enum": ["fixture-verified", "experimental"]
        },
        "version_basis": {
          "enum": ["declared-schema", "observed-unversioned", "mixed"]
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/format" }
        },
        "test_scripts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unknown_record_policy": { "type": "string", "minLength": 1 },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versions", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": {
                "enum": ["raw-fixture", "canonical-fixture", "test"]
              },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
